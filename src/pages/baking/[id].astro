---
import GoodBread from '../../layouts/GoodBread.astro'
import Underline from '../../components/Underline.astro'
import { bakeImage, bakeWithNeighbours, sortedBakes } from '../../bakes'
import { WORKER_BASE } from '../../utils'

export async function getStaticPaths() {
  const bakes = await sortedBakes()

  return bakes.map((bake, i) => ({
    params: { id: bake.id },
    props: bakeWithNeighbours(bakes, i),
  }))
}

// Astro supplies props by matching each prerendered path back to its
// getStaticPaths entry. When that lookup misses, props arrive empty and
// destructuring `bake` throws, which aborts the entire build rather than the
// one page. Resolve from the route param instead so the page never depends on
// that match succeeding.
let { bake, prev, next } = Astro.props
if (!bake) {
  const bakes = await sortedBakes()
  const i = bakes.findIndex((b) => b.id === Astro.params.id)
  if (i === -1) throw new Error(`No bake matches id "${Astro.params.id}"`)
  ;({ bake, prev, next } = bakeWithNeighbours(bakes, i))
}

const { data } = bake
const title = data.title || 'Bake'

const fmt = (d: Date, o: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', ...o }).format(d)
// occurs_at is a local wall-clock timestamp with no timezone (e.g. "2026-06-26T14:45:00").
// Parse as UTC so build output is deterministic regardless of the build server's timezone.
const asUtc = (s: string) => new Date(`${s}Z`)

const formatted = fmt(data.date, { month: 'short', day: 'numeric', year: 'numeric' })
const ingredients = data.ingredients.toSorted((a, b) => a.sort_order - b.sort_order)
const schedule = data.schedule.toSorted((a, b) => a.sort_order - b.sort_order)

const days = schedule.reduce<{ key: string; label: string; steps: typeof schedule }[]>(
  (groups, s) => {
    // occurs_at is nullable — an entry can have an action but no scheduled time.
    const key = s.occurs_at ? s.occurs_at.slice(0, 10) : 'unscheduled'
    const label = s.occurs_at
      ? fmt(asUtc(s.occurs_at), { weekday: 'long', month: 'short', day: 'numeric' })
      : 'Unscheduled'
    const last = groups[groups.length - 1]
    if (last?.key === key) last.steps.push(s)
    else groups.push({ key, label, steps: [s] })
    return groups
  },
  []
)

const photos = await Promise.all(
  data.photos.map(async (p, k) => {
    const img = await bakeImage(p.url, 1200, 82)
    return { ...img, alt: p.caption || `${title}, photo ${k + 1}` }
  })
)

const ogImages =
  data.photos.length > 0 ? data.photos.map((p) => `${WORKER_BASE}${p.url}`) : undefined
---

<GoodBread
  title={`${title} · Bake log`}
  description={`Bake from ${formatted}`}
  image={ogImages}
>
  <div class="bk narrow">
    <nav class="bk-top"><a class="bk-back" href="/baking/">&larr; All bakes</a></nav>

    <main class="bk-bake">
      <h1 class="bk-title"><Underline>{title}</Underline></h1>
      <p class="bk-when"><time datetime={data.bake_date}>{formatted}</time></p>

      <h2 class="bk-h2">Ingredients</h2>
      <ul class="bk-ings">
        {
          ingredients.map((i) => (
            <li>
              <b>
                {i.amount_value}
                {i.unit}
              </b>{' '}
              {i.name.toLowerCase()}
              {i.note && <small> — {i.note}</small>}
            </li>
          ))
        }
      </ul>

      {
        days.length > 0 && (
          <>
            <h2 class="bk-h2">Schedule</h2>
            {days.map((g) => (
              <div class="bk-day">
                <h3>{g.label}</h3>
                <ol class="bk-steps">
                  {g.steps.map((s) => (
                    <li class="bk-step">
                      <span class="bk-time">
                        {s.occurs_at && (
                          <time datetime={s.occurs_at}>
                            {fmt(asUtc(s.occurs_at), {
                              hour: 'numeric',
                              minute: '2-digit',
                            })}
                          </time>
                        )}
                      </span>
                      <span class="bk-act">
                        {s.action}
                        {s.note && <small>{s.note}</small>}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </>
        )
      }

      {
        data.notes && (
          <>
            <h2 class="bk-h2">Notes</h2>
            <p class="bk-notes">{data.notes}</p>
          </>
        )
      }

      {
        photos.length > 0 && (
          <div class="bk-photos">
            {photos.map((p, k) => (
              <button
                class="bk-photo bk-print"
                type="button"
                data-full={p.src}
                data-w={p.width}
                data-h={p.height}
                aria-label={`Open photo ${k + 1}`}
              >
                <img
                  src={p.src}
                  width={p.width}
                  height={p.height}
                  alt={p.alt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
        )
      }

      <nav class="bk-pager" aria-label="More bakes">
        {
          prev && (
            <a class="prev" href={`/baking/${prev.id}/`}>
              &larr; prev
            </a>
          )
        }
        {
          next && (
            <a class="next" href={`/baking/${next.id}/`}>
              next &rarr;
            </a>
          )
        }
      </nav>
    </main>
  </div>

  <Fragment slot="foot-links">
    <a href="/">Home</a>
    <a href="/baking/">Bake log</a>
  </Fragment>

  <div
    slot="after"
    class="lightbox"
    id="closer"
    hidden
    tabindex="-1"
    role="dialog"
    aria-modal="true"
    aria-label="Photo"
  >
    <div class="closer-scrim"></div>
    <figure class="closer-print bk-closer" id="closer-print">
      <img id="closer-img" alt="" draggable="false" />
    </figure>
    <button
      class="closer-nav prev"
      id="closer-prev"
      type="button"
      aria-label="Previous photo">&larr;</button
    >
    <button class="closer-nav next" id="closer-next" type="button" aria-label="Next photo"
      >&rarr;</button
    >
  </div>
</GoodBread>

<script>
  import '../../scripts/bake-viewer.js'
</script>
