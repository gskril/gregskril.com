---
import { getCollection } from 'astro:content'
import GoodBread from '../layouts/GoodBread.astro'
import Underline from '../components/Underline.astro'

const articles = await getCollection('articles')
articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(d)
---

<GoodBread
  title="Blog · Greg Skriloff"
  description="Thoughts and tutorials on tech and crypto."
>
  <div class="bk">
    <nav class="bk-top"><a class="bk-back" href="/">&larr; Greg</a></nav>

    <header class="bk-head">
      <h1 class="bk-title"><Underline>Blog</Underline></h1>
      <p class="bk-intro">A few things I wrote.</p>
    </header>

    <main>
      <ul class="bl-list">
        {
          articles.map((a) => (
            <li>
              <a href={`/blog/${a.id}/`}>
                <span class="bl-date">{fmt(a.data.date)}</span>
                <span class="bl-title">{a.data.title}</span>
                <span class="bl-desc">{a.data.description}</span>
                <span class="bl-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</GoodBread>
