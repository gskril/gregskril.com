---
import GoodBread from '../layouts/GoodBread.astro'
import Underline from '../components/Underline.astro'
import { sortedBakes } from '../bakes'

const bakes = await sortedBakes()
const currentYear = new Date().getFullYear()

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: date.getUTCFullYear() === currentYear ? undefined : 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date)
---

<GoodBread
  title="Bake log · Greg Skriloff"
  description="A personal sourdough baking log."
  image={[
    'https://gregskril.com/img/baking/og-1.webp',
    'https://gregskril.com/img/baking/og-2.webp',
    'https://gregskril.com/img/baking/og-3.webp',
  ]}
>
  <div class="bk">
    <nav class="bk-top"><a class="bk-back" href="/">&larr; Home</a></nav>

    <header class="bk-head">
      <h1 class="bk-title"><Underline>Bake log</Underline></h1>
    </header>

    <main>
      <ul class="bk-log">
        {
          bakes.map((bake) => (
            <li>
              <a href={`/baking/${bake.id}/`}>
                <time datetime={bake.data.bake_date}>{fmt(bake.data.date)}</time>
                <span>{bake.data.title || 'Bake'}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="bk-more">
        &hellip;and dozens of other loaves before I started this log. See some on <a
          href="https://goodbread.nyc/?ref=gregskril.com"
          target="_blank"
          rel="noopener">goodbread.nyc</a
        >.
      </p>
    </main>
  </div>

  <Fragment slot="foot-links">
    <a href="/">Home</a>
    <a href="https://goodbread.nyc" target="_blank" rel="noopener">
      Good Bread <span aria-hidden="true">&#8599;</span>
    </a>
  </Fragment>
</GoodBread>
