---
import GoodBread from '../layouts/GoodBread.astro'
import Eyes from '../components/Eyes.astro'
import ART from '../art'

// A few highlights; the rest of the side projects are the tally marks.
const projects = [
  {
    name: 'Good Bread',
    url: 'https://goodbread.nyc',
    desc: 'My tiny bakery. You order bread, I bake it.',
  },
  {
    name: 'API Racer',
    url: 'https://api-racer.gregskril.com',
    desc: "Races an API from 5 regions to see where it's slow.",
  },
  {
    name: 'RPC Monitor',
    url: 'https://rpc-monitor.gregskril.com/',
    desc: "Keeps an eye on RPC endpoints so I don't have to.",
  },
  {
    name: 'Make Quotes',
    url: 'https://makequotes.gregskril.com/',
    desc: 'Square text graphics for posting on social.',
  },
  {
    name: 'Searchcaster',
    url: 'https://searchcaster.xyz/',
    desc: 'Search for a decentralized social network.',
  },
]
---

<GoodBread
  title="Greg Skriloff"
  description="I'm Greg. I live in New York, and I like baking bread and building software."
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title="RSS"
    href="/rss.xml"
  />

  <div class="page" id="page">
    <!-- the one line: built and drawn by line.js -->
    <svg id="line" aria-hidden="true" focusable="false"></svg>
    <div id="tip" aria-hidden="true"><span set:html={ART.loaf} /></div>

    <header class="hello" id="hello">
      <div
        class="hello-portrait"
        id="a-portrait"
        role="img"
        aria-label="A line drawing of Greg"
      >
      </div>

      <div class="hello-copy">
        <div class="hello-eyes" id="a-word"><Eyes /></div>
        <div class="hello-text">
          <h1 class="lead" id="a-lead">Hi, I'm Greg.</h1>
          <p>I live in New York. I like baking bread and building software.</p>
          <p class="aside">By day I'm a Developer Relations Engineer at ENS&nbsp;Labs.</p>
          <div class="btns">
            <a class="btn" href="#things">Things I made</a>
            <a class="btn" href="#hi">Say hi</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="bread" id="bread" aria-labelledby="bread-title">
        <div class="bread-art" id="a-art" set:html={ART.holding} />
        <div class="bread-copy">
          <h2 class="section-title" id="bread-title">
            I bake a lot of bread and <span class="nowrap" id="a-phrase"
              >write it all down</span
            >
          </h2>
          <p>
            Every loaf goes in my bake log, the good ones and the flat ones. When there's
            extra, I sell it to friends. That part is called Good&nbsp;Bread.
          </p>
          <div class="btns">
            <a class="btn" href="/baking/">Bake log</a>
            <a class="btn" href="https://goodbread.nyc" target="_blank" rel="noopener">
              Good Bread <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </div>
      </section>

      <section class="things" id="things" aria-labelledby="things-title">
        <h2 class="section-title" id="things-title">Some things I made</h2>
        <ul class="rows" id="a-rows">
          {
            projects.map((p, i) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener">
                  <span class="r-name">
                    {i === 0 ? <span id="a-circle">{p.name}</span> : p.name}
                  </span>
                  <span class="r-desc">{p.desc}</span>
                  <span class="r-arrow" aria-hidden="true">
                    &#8599;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="tally" id="a-tally" aria-hidden="true"></div>
        <p class="tally-note">
          Plus 60+ more that I made by hand, back before AI could lend&nbsp;one.
        </p>
      </section>

      <section class="photos" id="photos" aria-labelledby="photos-title">
        <div class="photos-head">
          <h2 class="section-title" id="photos-title">Pictures from places I've been</h2>
          <p class="photos-hint">
            <span class="fine">Drag them around, or click one for a closer look.</span
            ><span class="coarse">Tap one for a closer look, then swipe.</span>
          </p>
        </div>
        <div class="pile" id="a-pile"></div>
      </section>

      <section class="hi" id="hi" aria-labelledby="hi-title">
        <img
          class="hi-me"
          id="a-me"
          src="/img/profile.jpg"
          width="960"
          height="960"
          alt="Greg, standing on the roof of a car with mountains behind him"
          loading="lazy"
          decoding="async"
        />
        <h2 class="section-title" id="hi-title">Say hi</h2>
        <p>I'm friendly. You can find me here.</p>
        <div class="hi-links" id="a-links">
          <a class="btn" href="https://github.com/gskril" target="_blank" rel="noopener"
            >GitHub</a
          >
          <a
            class="btn"
            href="https://twitter.com/gregskril"
            target="_blank"
            rel="noopener">Twitter</a
          >
        </div>
        <div class="hi-end" id="a-end"></div>
      </section>
    </main>
  </div>

  <!-- one photo, opened up and centered -->
  <div
    slot="after"
    class="lightbox"
    id="closer"
    hidden
    tabindex="-1"
    role="dialog"
    aria-modal="true"
    aria-label="Photo"
  >
    <div class="closer-scrim"></div>
    <figure class="closer-print" id="closer-print">
      <img id="closer-img" alt="" draggable="false" />
      <figcaption><span id="closer-place"></span></figcaption>
    </figure>
    <button
      class="closer-nav prev"
      id="closer-prev"
      type="button"
      aria-label="Previous photo">&larr;</button
    >
    <button class="closer-nav next" id="closer-next" type="button" aria-label="Next photo"
      >&rarr;</button
    >
  </div>
</GoodBread>

<script>
  import '../scripts/art-global'
  import '../scripts/eyes.js'
  import '../scripts/photos.js'
  import '../scripts/line.js'
</script>
