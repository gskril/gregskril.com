---
/*
  Loaf Around: a little bread-baking clicker, tucked away as an easter egg
  (linked from the 404 page). The game itself lives in src/scripts/bakery.js.
*/
import GoodBread from '../layouts/GoodBread.astro'
import Underline from '../components/Underline.astro'
import { loaf, babka, baguette } from '../art'
---

<GoodBread
  title="Loaf Around · Greg Skriloff"
  description="A little bread-baking game. Press the bread, hire some help, build a bakery."
>
  <div class="bk gm">
    <nav class="bk-top"><a class="bk-back" href="/">&larr; Home</a></nav>

    <header class="bk-head gm-head">
      <h1 class="bk-title"><Underline>Loaf Around</Underline></h1>
      <p class="bk-intro">
        Press the bread to bake. Spend loaves on help that bakes for you. The bakery keeps going
        while you're away.
      </p>
    </header>

    <noscript><p class="gm-note">This one needs JavaScript to bake, sorry.</p></noscript>

    <main class="gm-grid">
      <section class="gm-oven" aria-labelledby="gm-oven-title">
        <h2 id="gm-oven-title" class="sr-only">Your bread</h2>
        <p class="gm-tally">
          <span id="gm-count" class="gm-count">0</span>
          <span id="gm-unit" class="gm-unit">loaves</span>
        </p>
        <p id="gm-rate" class="gm-rate">0 per second</p>

        <div id="gm-stage" class="gm-stage">
          <button
            type="button"
            id="gm-bread"
            class="gm-bread"
            aria-label="Bake bread"
            aria-describedby="gm-per-click"
          >
            <span class="gm-art" id="gm-art-loaf" set:html={loaf} />
            <span class="gm-art" id="gm-art-babka" set:html={babka} hidden />
            <span class="gm-art" id="gm-art-baguette" set:html={baguette} hidden />
          </button>
        </div>
        <p class="gm-bread-name" id="gm-bread-name">Country loaf</p>
        <p class="gm-small" id="gm-per-click">Each press bakes 1 loaf.</p>
        <p class="gm-away" id="gm-away" role="status" hidden></p>
      </section>

      <div class="gm-shop">
        <section aria-labelledby="gm-helpers-title">
          <h2 class="gm-h2" id="gm-helpers-title">Help</h2>
          <p class="gm-small">Each one bakes on its own. Prices rise as you buy.</p>
          <ul class="gm-helpers" id="gm-helpers"></ul>
        </section>

        <section aria-labelledby="gm-tech-title">
          <h2 class="gm-h2" id="gm-tech-title">Techniques</h2>
          <p class="gm-small" id="gm-tech-none">Keep baking. New techniques show up as you go.</p>
          <ul class="gm-tech" id="gm-tech"></ul>
        </section>

        <section aria-labelledby="gm-miles-title">
          <h2 class="gm-h2" id="gm-miles-title">Milestones</h2>
          <p class="gm-small">Each one makes your help bake 5% more.</p>
          <ul class="gm-miles" id="gm-miles"></ul>
        </section>

        <footer class="gm-foot">
          <p class="gm-small" id="gm-stats"></p>
          <div class="gm-reset">
            <button type="button" class="gm-link" id="gm-reset">Start over</button>
            <div id="gm-confirm" class="gm-confirm" hidden>
              <p>Throw out every loaf and start from scratch?</p>
              <div class="gm-confirm-btns">
                <button type="button" class="gm-pill" id="gm-yes">Yes, start over</button>
                <button type="button" class="gm-pill" id="gm-no">Keep baking</button>
              </div>
            </div>
          </div>
        </footer>
      </div>
    </main>

    <p id="gm-say" class="sr-only" role="status" aria-live="polite"></p>
    <p id="gm-say-count" class="sr-only" aria-live="polite"></p>
  </div>
</GoodBread>

<script>
  import '../scripts/bakery.js'
</script>

<style is:global>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .gm-head { padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .gm-note { font-family: var(--pangram); }
  .gm-small { font-size: .9375rem; opacity: .8; }

  .gm-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
    gap: clamp(2.5rem, 6vw, 5rem); align-items: start;
  }
  @media (max-width: 54rem) { .gm-grid { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- the bread ---------- */
  .gm-oven { text-align: center; }
  @media (min-width: 54.0625rem) { .gm-oven { position: sticky; top: 1.5rem; } }
  .gm-tally { display: flex; justify-content: center; align-items: baseline; flex-wrap: wrap; gap: 0 .4em; }
  .gm-count {
    font-family: var(--pangram); font-weight: 800; font-variant-numeric: tabular-nums;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4rem); line-height: 1.1; overflow-wrap: anywhere;
  }
  .gm-unit { font-family: var(--pangram); font-size: 1.25rem; }
  .gm-rate { font-family: var(--pangram); font-variant-numeric: tabular-nums; opacity: .8; }

  .gm-stage { position: relative; overflow-x: clip; padding: 1.5rem 0 1rem; }
  .gm-bread {
    position: relative; display: block;
    width: min(100%, 21rem); aspect-ratio: 1; margin: 0 auto; padding: 0;
    border: 1px solid var(--rule); border-radius: 50%;
    background: var(--paper-2); color: var(--ink);
    cursor: pointer; touch-action: manipulation; user-select: none; -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: border-color .15s ease, background-color .3s ease;
  }
  .gm-bread:hover { border-color: var(--ink); }
  .gm-bread:focus-visible { outline: 2px solid var(--ink); outline-offset: 6px; border-radius: 50%; }
  /* the art sits inside the circle, so a tall bread can't stretch it */
  .gm-art { position: absolute; inset: 14%; display: block; pointer-events: none; }
  .gm-art[hidden] { display: none; }
  .gm-art svg { display: block; width: 100%; height: 100%; overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .gm-art { transition: transform .2s ease; }
    .gm-bread:hover .gm-art { transform: rotate(-4deg) scale(1.03); }
  }
  .gm-bread-name { font-family: var(--pangram); text-transform: uppercase; letter-spacing: .06em; font-size: .875rem; }
  .gm-float {
    position: absolute; z-index: 3; pointer-events: none; white-space: nowrap;
    font-family: var(--pangram); font-weight: 800; font-size: 1.375rem; color: var(--ink);
    text-shadow: 0 0 6px var(--paper), 0 0 2px var(--paper);
  }
  .gm-away {
    margin: 1.25rem auto 0; max-width: 24rem; padding: .75rem 1rem;
    border: 1px solid var(--ink); border-radius: 1rem; font-size: 1rem;
  }

  /* ---------- the shop ---------- */
  .gm-shop > section + section { margin-top: 2.75rem; }
  .gm-h2 { font-family: var(--pangram); font-weight: 800; font-size: 1.25rem; margin-bottom: .25rem; }
  .gm-helpers, .gm-tech, .gm-miles { list-style: none; margin: .9rem 0 0; padding: 0; }
  .gm-helpers li { border-top: 1px solid var(--rule); }
  .gm-helpers li:last-of-type { border-bottom: 1px solid var(--rule); }
  .gm-helpers li[hidden] { display: none; }

  .gm-buy, .gm-tech-btn {
    font: inherit; color: inherit; text-align: left; cursor: pointer;
    -webkit-tap-highlight-color: transparent; touch-action: manipulation;
    transition: background-color .15s ease, opacity .15s ease, border-color .15s ease;
  }
  .gm-buy {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center;
    width: 100%; padding: .8rem .75rem; border: 0; border-radius: .75rem; background: none;
  }
  .gm-buy:hover, .gm-tech-btn:hover { background: var(--paper-2); }
  .gm-buy[aria-disabled="true"], .gm-tech-btn[aria-disabled="true"] { opacity: .45; cursor: default; }
  .gm-buy[aria-disabled="true"]:hover, .gm-tech-btn[aria-disabled="true"]:hover { background: none; }
  .gm-buy-text, .gm-buy-side { display: flex; flex-direction: column; min-width: 0; }
  .gm-buy-side { align-items: flex-end; text-align: right; }
  .gm-buy-name { font-family: var(--pangram); font-weight: 600; font-size: 1.0625rem; }
  .gm-buy-desc { font-size: .9375rem; opacity: .8; line-height: 1.35; }
  .gm-buy-cost { font-family: var(--pangram); font-variant-numeric: tabular-nums; font-size: .9375rem; white-space: nowrap; }
  .gm-buy-cost::after { content: " loaves"; opacity: .8; }
  .gm-tech .gm-buy-cost::after { content: none; }
  .gm-buy-own { font-family: var(--pangram); font-weight: 800; font-size: 1.5rem; line-height: 1.1; font-variant-numeric: tabular-nums; }

  .gm-tech { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr)); gap: .6rem; }
  .gm-tech-btn {
    display: flex; flex-direction: column; gap: .2rem; width: 100%; height: 100%;
    padding: .8rem 1rem; border: 1px solid var(--ink); border-radius: 1rem; background: var(--paper);
  }
  .gm-tech-btn .gm-buy-cost { margin-top: auto; padding-top: .3rem; }

  .gm-miles { display: grid; gap: .35rem; }
  .gm-miles li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: .5rem; opacity: .55; }
  .gm-miles li.done { opacity: 1; }
  .gm-mile-mark {
    grid-row: span 2; width: 1.25rem; height: 1.25rem; margin-top: .2rem;
    border: 1px solid currentColor; border-radius: 50%;
    display: grid; place-items: center; font-size: .75rem; line-height: 1;
  }
  .gm-miles li.done .gm-mile-mark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .gm-mile-name { font-family: var(--pangram); font-weight: 600; font-size: 1rem; }
  .gm-mile-goal { font-size: .875rem; opacity: .8; }

  .gm-foot { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .gm-reset { margin-top: 1rem; }
  .gm-link {
    font: inherit; font-size: .9375rem; color: inherit; background: none; border: 0; padding: 0;
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer; opacity: .8;
  }
  .gm-link:hover { opacity: 1; }
  .gm-link[hidden], .gm-confirm[hidden] { display: none; }
  .gm-confirm p { font-size: 1rem; }
  .gm-confirm-btns { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
  .gm-pill {
    font-family: var(--pangram); font-size: .9375rem; text-transform: uppercase; color: var(--ink); cursor: pointer;
    border: 1px solid var(--ink); border-radius: 999px; padding: .35rem 1rem .3rem; background: var(--paper);
    transition: background-color .15s ease, color .15s ease, border-color .15s ease;
  }
  .gm-pill:hover, .gm-pill:focus-visible { background: var(--hover); color: var(--hover-ink); border-color: var(--hover); }
</style>
