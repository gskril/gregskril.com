---
/*
  The site layout, in the Good Bread style (goodbread.nyc, designed by Erin).
*/
import '../styles/gb.css'
import BaseHead from '../components/BaseHead.astro'
import ART from '../art'

interface Props {
  title: string
  description: string
  image?: string | string[]
  heroPicker?: boolean
}

const { title, description, image, heroPicker = false } = Astro.props
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="preload"
      href="/fonts/pangram-extrabold.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/pangram-compact-regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <script is:inline>
      // Review-only: ?review shows the palette/hero picker, and a chosen palette sticks around.
      ;(() => {
        const root = document.documentElement
        const q = new URLSearchParams(location.search)
        if (q.has('review')) root.dataset.review = ''
        const hero = q.get('hero')
        if (hero === 'eyes' || hero === 'none') root.dataset.hero = hero
        try {
          const t = localStorage.getItem('gb-theme')
          if (t && /^(light|navy|charcoal|espresso)$/.test(t)) root.dataset.theme = t
        } catch (e) {}
      })()
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />

    <a
      class="tagline"
      href="https://goodbread.nyc"
      target="_blank"
      rel="noopener"
      aria-label="It's a good day for bread. Visit Good Bread."
      set:html={ART.tagline}
    />

    <footer class="foot">
      <span>&copy; {year} Greg Skriloff</span>
      <span class="foot-links"><slot name="foot-links" /></span>
    </footer>

    <slot name="after" />

    <div class="review" id="review" role="group" aria-label="Palette (review only)">
      <span class="review-label">palette</span>
      <button type="button" data-theme="">auto</button>
      <button type="button" data-theme="light">light</button>
      <button type="button" data-theme="navy">navy</button>
      <button type="button" data-theme="charcoal">charcoal</button>
      <button type="button" data-theme="espresso">espresso</button>
      {
        heroPicker && (
          <>
            <span class="review-sep" aria-hidden="true" />
            <span class="review-label">hero</span>
            <a href="?review" data-hero="">
              GREG + eyes
            </a>
            <a href="?review&hero=eyes" data-hero="eyes">
              eyes
            </a>
            <a href="?review&hero=none" data-hero="none">
              neither
            </a>
          </>
        )
      }
    </div>

    <script>
      import '../scripts/review.js'
      import '../scripts/favicon.js'
    </script>
  </body>
</html>
