---
/*
  The site layout, in the Good Bread style (goodbread.nyc, designed by Erin).
*/
import '../styles/gb.css'
import BaseHead from '../components/BaseHead.astro'

interface Props {
  title: string
  description: string
  image?: string | string[]
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="preload"
      href="/fonts/pangram-extrabold.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/pangram-compact-regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <script is:inline>
      // Review-only: ?review shows the palette picker, and a chosen palette sticks around.
      ;(() => {
        const root = document.documentElement
        const q = new URLSearchParams(location.search)
        if (q.has('review')) root.dataset.review = ''
        try {
          const t = localStorage.getItem('gb-theme')
          if (t && /^(light|navy|charcoal|espresso)$/.test(t)) root.dataset.theme = t
        } catch (e) {}
      })()
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />

    <slot name="after" />

    <div class="review" id="review" role="group" aria-label="Palette (review only)">
      <span class="review-label">palette</span>
      <button type="button" data-theme="">auto</button>
      <button type="button" data-theme="light">light</button>
      <button type="button" data-theme="navy">navy</button>
      <button type="button" data-theme="charcoal">charcoal</button>
      <button type="button" data-theme="espresso">espresso</button>
    </div>

    <script>
      import '../scripts/review.js'
      import '../scripts/favicon.js'
    </script>
  </body>
</html>
