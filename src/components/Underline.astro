---
// Erin's UnderlineScribble from goodbread.nyc, drawn in once under a title.
import { SCRIBBLE as d } from '../scribble.js'
---

<span class="bk-under"
  ><slot /><svg
    viewBox="0 -8 307 40"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"><path d={d} pathLength="1"></path></svg
  ></span
>
